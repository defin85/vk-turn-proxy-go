#!/usr/bin/env bash
set -euo pipefail

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLIENTD="${APP_DIR}/libexec/clientd"

if [[ ! -x "${CLIENTD}" ]]; then
  echo "RelayDock clientd binary not found: ${CLIENTD}" >&2
  exit 1
fi

exec env \
  VKTP_LINUX_PACKAGED_TARGET=ubuntu \
  "${CLIENTD}" "$@"
