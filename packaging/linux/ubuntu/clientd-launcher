#!/usr/bin/env bash
set -euo pipefail

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WRAPPER="${APP_DIR}/libexec/relaydock-clientd-linux-tun"

if [[ ! -x "${WRAPPER}" ]]; then
  echo "RelayDock Linux TUN wrapper not found: ${WRAPPER}" >&2
  exit 1
fi

if [[ "$(id -u)" -eq 0 ]]; then
  exec "${WRAPPER}" "$@"
fi

if ! command -v pkexec >/dev/null 2>&1; then
  echo "pkexec is required to start the packaged RelayDock Linux TUN host." >&2
  exit 1
fi

exec pkexec "${WRAPPER}" "$@"
